{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story_plan_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_fingerprint",
    "title",
    "entry_scene_id",
    "flags",
    "initial_flags",
    "scenes"
  ],
  "properties": {
    "format": {
      "const": "rpg_author_story_plan_v1"
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "description": "Runtime additionally bounds UTF-16 code units."
    },
    "entry_scene_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "initial_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapter_index",
          "origin",
          "assertion_ids",
          "text",
          "terminal",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "chapter_index": {
            "type": "integer",
            "minimum": 0
          },
          "origin": {
            "enum": [
              "SOURCE_PASSAGE",
              "EXPLICIT_ADAPTATION"
            ]
          },
          "assertion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 24,
            "uniqueItems": true
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S",
            "description": "Runtime additionally bounds UTF-16 code units."
          },
          "terminal": {
            "type": "boolean"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "next_scene_id",
                "requires",
                "forbids",
                "adds",
                "removes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "\\S",
                  "description": "Runtime additionally bounds UTF-16 code units."
                },
                "next_scene_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "requires": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "forbids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "adds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "removes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": true
                }
              }
            },
            "minItems": 0,
            "maxItems": 16
          }
        }
      },
      "minItems": 3,
      "maxItems": 192
    }
  }
}
