{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shonentez-afk/AI-Story-RPG/shared_schemas/v1/story_blueprint.schema.json",
  "title": "AI Story RPG – deterministic M1.7 scene blueprint, not a .bworld ZIP",
  "description": "Strict, non-executable JSON intermediate format for original demo content. External runtime remains story_engine. Cross-reference and reachability checks are performed by story_core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "book_id",
    "title",
    "entry_scene_id",
    "rights_status",
    "source_fingerprint",
    "supported_modes",
    "items",
    "facts",
    "actors",
    "initial_state",
    "scenes"
  ],
  "properties": {
    "format": {
      "const": "ai_story_blueprint_v1"
    },
    "schema_version": {
      "const": 1
    },
    "book_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "entry_scene_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "rights_status": {
      "const": "original_demo"
    },
    "source_fingerprint": {
      "type": "null"
    },
    "supported_modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "plots",
        "interactions"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "PROTAGONIST"
          }
        },
        "plots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "CANON"
          }
        },
        "interactions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "CLASSIC"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "initial_state": {
      "$ref": "#/$defs/world_state"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id"
          ],
          "properties": {
            "op": {
              "const": "has_item"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "value"
          ],
          "properties": {
            "op": {
              "const": "flag_is"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "amount"
          ],
          "properties": {
            "op": {
              "const": "stat_at_least"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "actor"
          ],
          "properties": {
            "op": {
              "const": "knows_fact"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "actor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "amount"
          ],
          "properties": {
            "op": {
              "const": "tick_at_least"
            },
            "amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id"
          ],
          "properties": {
            "op": {
              "const": "grant_item"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id"
          ],
          "properties": {
            "op": {
              "const": "consume_item"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "value"
          ],
          "properties": {
            "op": {
              "const": "set_flag"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "amount"
          ],
          "properties": {
            "op": {
              "const": "stat_delta"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "amount": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000,
              "not": {
                "const": 0
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "id",
            "actor"
          ],
          "properties": {
            "op": {
              "const": "learn_fact"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "actor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "amount"
          ],
          "properties": {
            "op": {
              "const": "advance_time"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "next_scene_id",
        "conditions",
        "effects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "next_scene_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "conditions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "effects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "terminal",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        },
        "terminal": {
          "type": "boolean"
        },
        "choices": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "world_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "revision",
        "tick",
        "stats",
        "inventory",
        "flags",
        "knowledge"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "stats": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "inventory": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "flags": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "knowledge": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        }
      }
    }
  }
}
